{
  "schemaVersion": "1.0.0",
  "readme": "Généré par z-manifest depuis les blocs `static api`. Ne pas éditer à la main.",
  "modules": [
    {
      "kind": "javascript-module",
      "path": "core/z-element/z-element.js",
      "declarations": [
        {
          "kind": "class",
          "name": "ZElement",
          "tagName": "z-element",
          "summary": "La base vivante : porte les états d'interaction en :state() et émet z-state.",
          "attributes": [
            {
              "name": "current",
              "type": {
                "text": "boolean"
              },
              "description": "Sélection durable (coché, onglet actif) — posée par un composant sélectionnable."
            },
            {
              "name": "loading",
              "type": {
                "text": "boolean"
              },
              "description": "Statut : en chargement."
            },
            {
              "name": "busy",
              "type": {
                "text": "boolean"
              },
              "description": "Statut : occupé / traitement en cours."
            },
            {
              "name": "disabled",
              "type": {
                "text": "boolean"
              },
              "description": "Désactivé : coupe l'interaction."
            },
            {
              "name": "error",
              "type": {
                "text": "boolean"
              },
              "description": "Statut : en erreur."
            },
            {
              "name": "success",
              "type": {
                "text": "boolean"
              },
              "description": "Statut : validé."
            }
          ],
          "events": [
            {
              "name": "z-state",
              "description": "Émis à chaque changement d'état. detail : { states, changed, on }."
            }
          ],
          "cssProperties": [
            {
              "name": "--z-dur-enter",
              "description": "Durée de l'état transitoire `enter` (lue dans la cascade)."
            },
            {
              "name": "--z-dur-release",
              "description": "Durée de l'onde `release`."
            }
          ],
          "cssStates": [
            {
              "name": "default"
            },
            {
              "name": "over"
            },
            {
              "name": "press"
            },
            {
              "name": "release"
